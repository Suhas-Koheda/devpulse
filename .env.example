# DevPulse Environment Configuration
# Copy this file to .env and fill in your values

# --- GitHub API Token (OPTIONAL but RECOMMENDED) ---
# Get a free token at https://github.com/settings/tokens
# Raises rate limit from 60/hour to 5,000/hour
GITHUB_TOKEN=

# --- LLM Backend Selection ---
# Options: "ollama" (default, local) or "groq" (cloud)
LLM_BACKEND=ollama

# --- Ollama Configuration (for local models) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# --- Groq Configuration (for cloud models) ---
# Get API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant